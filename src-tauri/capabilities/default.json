{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The Studio page comes from the local Python server; it may only drag the window by its title areas.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:*"
    ]
  }
}
